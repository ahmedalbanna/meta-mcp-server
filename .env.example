# Meta Graph API credentials (FB_* naming)
FB_APP_ID=your_app_id_here
FB_APP_SECRET=your_app_secret_here
FB_ACCESS_TOKEN=your_access_token_here

FB_API_VERSION=v26.0

# Object ids — discover with list_pages / list_ad_accounts / discover_ig_user
FB_PAGE_ID=
FB_AD_ACCOUNT_ID=act_123456789
FB_IG_USER_ID=
# FB_BUSINESS_ID=

# Write gating & ad-spend guardrails (safe defaults: writes OFF)
FB_ENABLE_WRITES=false
FB_DRY_RUN=false
FB_ADS_ALLOW_ACTIVATE=false
FB_ADS_MAX_DAILY_BUDGET=0
FB_ADS_MAX_LIFETIME_BUDGET=0
