# Meta Graph API credentials (FB_* naming)
FB_APP_ID=your_app_id_here
FB_APP_SECRET=your_app_secret_here
FB_ACCESS_TOKEN=your_access_token_here

FB_API_VERSION=v27.0

# Object ids — discover with list_pages / list_ad_accounts / discover_ig_user
FB_PAGE_ID=
FB_AD_ACCOUNT_ID=act_123456789
FB_AD_ACCOUNT_IDS=act_123456789,act_987654321
FB_IG_USER_ID=
# FB_BUSINESS_ID=
# FB_COMMERCE_ACCOUNT_ID=
# WhatsApp Business (Cloud API)
# FB_WABA_ID=
# FB_WHATSAPP_PHONE_NUMBER_ID=

# Permanent media hosting (Phase 10) — Cloudinary for years vs temporary uguu.se 72h
# Get from cloudinary.com → Dashboard → CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# If set, all media/*.jpeg uploads use Cloudinary (permanent). If empty, falls back to uguu.se (temporary)
# CLOUDINARY_URL=cloudinary://123456789:abcDEF@mycloud
# Alternative split form:
# CLOUDINARY_CLOUD_NAME=mycloud
# CLOUDINARY_API_KEY=123456789
# CLOUDINARY_API_SECRET=abcDEF

# Write gating & ad-spend guardrails (safe defaults: writes OFF)
FB_ENABLE_WRITES=false
FB_DRY_RUN=false
FB_ADS_ALLOW_ACTIVATE=false
FB_ADS_MAX_DAILY_BUDGET=0
FB_ADS_MAX_LIFETIME_BUDGET=0
FB_CONFIRM_WRITES=false
# Concurrency & observability (Phase 4)
FB_MAX_CONCURRENT=4
FB_ADAPTIVE_THROTTLE=true
FB_AUTO_RUN_WEBHOOK_AUTOMATIONS=false
# Enterprise (Phase 8)
FB_MCP_ALLOWED_TASKS=ADVERTISE,ANALYZE,MANAGE,DRAFT
FB_SCHEDULER_DB_URL=sqlite:///reports/scheduler.db
# Webhook receiver (webhook_server.py)
# FB_META_WEBHOOK_VERIFY_TOKEN=
# FB_WEBHOOK_PORT=8080

# Optional page-scoped token (usually auto-derived) — uncomment to override
# FB_PAGE_ACCESS_TOKEN=
